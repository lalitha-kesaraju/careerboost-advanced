# Gemini API Key (Required for AI features)
# In this environment, GEMINI_API_KEY is automatically provided.
# If running locally, add your key below:
GEMINI_API_KEY=

# Firebase service account key (Required for usage/tier limit enforcement)
# Vercel has no Application Default Credentials, unlike GCP infra — this
# feature silently no-ops without it. Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the raw JSON content as a single-line value below (or as a Vercel env var).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Add any other third-party keys here
# VITE_OTHER_SERVICE_KEY=
