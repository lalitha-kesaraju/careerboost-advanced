# ─── Gemini API (Backend) ────────────────────────────────────────────────────
# Required for all AI features. Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Firebase (Frontend — Vite exposes VITE_ prefixed vars to the browser) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DB_ID=

# ─── Admin emails (comma-separated, never commit real values) ─────────────────
VITE_ADMIN_EMAILS=admin@yourapp.com

# ─── Firebase (Backend — server.ts uses these via process.env) ───────────────
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DB_ID=

# ─── CORS (comma-separated list of allowed origins) ──────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
