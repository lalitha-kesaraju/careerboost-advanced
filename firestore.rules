rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin is determined solely by the verified JWT email — cannot be faked by writing to Firestore
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in ['admin@careerboost.ai', 'kesarajulalitha@gmail.com'];
    }

    function isValidUserData(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.role is string && data.role in ['User', 'Platform Admin'] &&
             data.tier in ['basic', 'medium', 'premium'] &&
             data.usage is map;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // On create: only admins may assign 'Platform Admin'; everyone else is forced to 'User'
      allow create: if isOwner(userId) &&
        isValidUserData(request.resource.data) &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.role == 'User' || isAdmin());

      // On update: owner may update their own doc but cannot escalate their own role
      allow update: if isValidUserData(request.resource.data) && (
        (isOwner(userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.role == resource.data.role)   // role is immutable by non-admin
        || isAdmin()
      );

      // Sub-collections (logs, resumes, applications, interviews, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
