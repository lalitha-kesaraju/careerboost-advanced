rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Auth tokens contain email if using Google or Email providers
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'admin@careerboost.ai',
          'kesarajulalitha@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'User') == 'Platform Admin')
      );
    }

    function isValidUser(data) {
      return data.userId is string && 
             data.email is string && 
             data.displayName is string &&
             data.role is string &&
             data.tier in ['basic', 'medium', 'premium'] &&
             data.usage is map;
    }

    // 2. User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && 
        isValidUser(request.resource.data) && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if (isOwner(userId) || isAdmin()) && 
        isValidUser(request.resource.data) &&
        request.resource.data.userId == resource.data.userId; // Immutable userId

      // 3. User Sub-collections (logs, resumes, applications, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 4. Global Deny-all fallback (for any other collection)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
